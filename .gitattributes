# ==========================================
# CAD Auto CloudNote - Git 属性配置 (.gitattributes)
# ==========================================

# 1. 文本文件换行符规范
* text=auto eol=crlf

# 源码与项目配置
*.cs text diff=csharp eol=crlf
*.xaml text diff=csharp eol=crlf
*.csproj text eol=crlf
*.shproj text eol=crlf
*.projitems text eol=crlf
*.slnx text eol=crlf
*.props text eol=crlf
*.xml text eol=crlf
*.json text eol=crlf
*.iss text eol=crlf

# 文档文件
*.md text eol=crlf
*.txt text eol=crlf
*.html text eol=crlf

# 脚本文件保持 LF
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=crlf

# 2. 二进制文件识别
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.cui binary
*.cuix binary
*.dwg binary
*.dxf binary
*.pdf binary
*.zip binary
*.7z binary
*.cloudnotepkg binary
