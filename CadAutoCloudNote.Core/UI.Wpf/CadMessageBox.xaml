<Window x:Class="CadAutoCloudNote.Core.UI.Wpf.CadMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CAD Auto CloudNote" Width="400" SizeToContent="Height" MinHeight="160"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei" FontSize="12"
        KeyDown="Window_KeyDown" ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#1E2530"/>
        <SolidColorBrush x:Key="TitleBarBg" Color="#171D25"/>
        <SolidColorBrush x:Key="AccentColor" Color="#0084FF"/>
        <SolidColorBrush x:Key="AccentHover" Color="#2997FF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A2B0C4"/>
        <SolidColorBrush x:Key="BorderLine" Color="#374354"/>
        <SolidColorBrush x:Key="ButtonBg" Color="#2F3C4D"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#3E4E63"/>
        <SolidColorBrush x:Key="ButtonPressed" Color="#252E3B"/>
        <SolidColorBrush x:Key="BottomBarBg" Color="#181F2A"/>
        <SolidColorBrush x:Key="BadgeBg" Color="#1E3A5F"/>

        <!-- 扁平按钮样式 -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#006CD9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource BorderLine}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBg}" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="TxtTitle" Text="提示" Foreground="{DynamicResource TextPrimary}"
                                FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="30"
                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondary}"
                            Cursor="Hand" Click="BtnClose_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBd" Background="Transparent" CornerRadius="0,10,0,0">
                                                <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBd" Property="Background" Value="#E81123"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 消息主体 -->
            <Grid Grid.Row="1" Margin="16,14,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 状态徽章图标 -->
                <Border x:Name="IconBadge" Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                        VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,2,14,0"
                        Background="{DynamicResource BadgeBg}">
                    <TextBlock x:Name="TxtIconSymbol" Text="?" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0084FF"/>
                </Border>

                <!-- 提示内容 -->
                <TextBlock x:Name="TxtMessage" Grid.Column="1" Text="消息文本内容"
                           Foreground="{DynamicResource TextPrimary}" FontSize="12"
                           TextWrapping="Wrap" LineHeight="18" VerticalAlignment="Center"/>
            </Grid>

            <!-- 底部按钮栏 -->
            <Border Grid.Row="2" Background="{DynamicResource BottomBarBg}" CornerRadius="0,0,10,10" BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,1,0,0" Padding="12,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnYes" Content="是(Y)" Style="{StaticResource PrimaryBtnStyle}" Margin="0,0,8,0" Click="BtnYes_Click" Visibility="Collapsed"/>
                    <Button x:Name="BtnNo" Content="否(N)" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,8,0" Click="BtnNo_Click" Visibility="Collapsed"/>
                    <Button x:Name="BtnOk" Content="确定" Style="{StaticResource PrimaryBtnStyle}" Margin="0,0,8,0" Click="BtnOk_Click" Visibility="Visible"/>
                    <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource SecondaryBtnStyle}" Click="BtnCancel_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
