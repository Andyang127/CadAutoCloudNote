<Window x:Class="CadAutoCloudNote.Core.UI.Wpf.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CAD Auto CloudNote - 全局设置" Width="460" Height="400" MinWidth="460" MinHeight="400" MaxWidth="460" MaxHeight="400" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei" FontSize="11">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#323B47"/>
        <SolidColorBrush x:Key="CardBg" Color="#282F3B"/>
        <SolidColorBrush x:Key="TitleBarBg" Color="#222933"/>
        <SolidColorBrush x:Key="NavBg" Color="#262D38"/>
        <SolidColorBrush x:Key="AccentColor" Color="#0084FF"/>
        <SolidColorBrush x:Key="AccentHover" Color="#2997FF"/>
        <SolidColorBrush x:Key="AccentGlow" Color="#1E3A5F"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A2B0C4"/>
        <SolidColorBrush x:Key="BorderLine" Color="#434E60"/>
        <SolidColorBrush x:Key="InputBg" Color="#1D232C"/>
        <SolidColorBrush x:Key="ButtonBg" Color="#384352"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#475568"/>
        <SolidColorBrush x:Key="ThumbNormalBg" Color="#4B5563"/>
        <SolidColorBrush x:Key="ThumbHoverBg" Color="#6B7280"/>
        <SolidColorBrush x:Key="SubCardBg" Color="#1D232C"/>
        <SolidColorBrush x:Key="DeepCardBg" Color="#1A212B"/>
        <SolidColorBrush x:Key="ListBg" Color="#151A22"/>
        <SolidColorBrush x:Key="PreviewCardBg" Color="#1C222B"/>
        <SolidColorBrush x:Key="BadgeBg" Color="#1B3552"/>
        <SolidColorBrush x:Key="BadgeBorder" Color="#2D5580"/>
        <SolidColorBrush x:Key="ChipBg" Color="#263445"/>
        <SolidColorBrush x:Key="ChipBorder" Color="#0084FF"/>
        <SolidColorBrush x:Key="ChipDisabledBg" Color="#181E27"/>

        <!-- 扁平现代输入框样式 -->
        <Style TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextSecondary}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 扁平现代复选框样式 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 现代统一圆角按钮样式 -->
        <Style TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 极简流线滑块样式 -->
        <Style x:Key="SlimScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumbBorder" Background="{DynamicResource ThumbNormalBg}" CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ThumbHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 全局默认 ScrollBar 样式（隐式应用于全局所有 ScrollViewer 与 ListBox，彻底剥离厚灰与上下箭头） -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="MinWidth" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource SlimScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="MinHeight" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource SlimScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SlimVerticalScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}"/>

        <Style x:Key="SlimScrollViewer" TargetType="ScrollViewer">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar Grid.Column="1" x:Name="PART_VerticalScrollBar"
                                       Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>

        <!-- 扁平现代 ComboBox 样式 -->
        <Style x:Key="BulletproofComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="4"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentGlow}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BulletproofComboBox" TargetType="ComboBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource BulletproofComboBoxItem}"/>
            <Setter Property="MaxDropDownHeight" Value="240"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="RootGrid">
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 覆盖在区域上响应点击弹出 (非可编辑模式下覆盖全框，可编辑模式下收敛至右侧按钮列) -->
                                    <ToggleButton x:Name="DropDownToggle"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      IsHitTestVisible="False"
                                                      Margin="{TemplateBinding Padding}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>

                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Style="{x:Null}"
                                             Background="Transparent"
                                             Foreground="{TemplateBinding Foreground}"
                                             BorderThickness="0"
                                             Padding="{TemplateBinding Padding}"
                                             VerticalAlignment="Center"
                                             Visibility="Hidden"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"/>

                                    <Path x:Name="Arrow"
                                          Grid.Column="1"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{DynamicResource TextSecondary}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   Focusable="False">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource WindowBg}"
                                        BorderBrush="{DynamicResource BorderLine}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4" Color="Black"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="DropDownToggle" Property="Grid.Column" Value="1"/>
                                <Setter TargetName="DropDownToggle" Property="Grid.ColumnSpan" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" CenterX="4" CenterY="2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource BulletproofComboBox}"/>

        <!-- AutoCAD 颜色下拉条目模板 -->
        <DataTemplate x:Key="ColorSwatchTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="14" Height="14" CornerRadius="2" Margin="0,0,8,0" Background="{Binding Brush}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1"/>
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- 扁平现代卡片样式 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- 侧边导航选项卡按钮样式 -->
        <Style x:Key="NavTabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="3,1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="ActiveIndicator" HorizontalAlignment="Left" Width="3" Height="16" CornerRadius="1.5"
                                        Background="{DynamicResource AccentColor}" Visibility="Collapsed" Margin="-4,0,0,0"/>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentGlow}"/>
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 快捷小按钮样式 -->
        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 命令徽标样式 -->
        <Style x:Key="CmdTagStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BadgeBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <!-- 外层主窗体容器 -->
    <Border Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBg}" CornerRadius="10,10,0,0" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="CAD 云线批注 - 全局设置" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BadgeBg}" BorderBrush="{DynamicResource BadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v0.1.0" Foreground="{DynamicResource AccentColor}" FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                        <Button x:Name="BtnTitleHelp" Width="30" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextSecondary}" Cursor="Hand" ToolTip="帮助与使用手册 (F1 / Readme.html)" Click="BtnHelp_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnHbd" Background="Transparent">
                                                    <TextBlock Text="?" FontSize="13" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnHbd" Property="Background" Value="{DynamicResource ButtonHover}"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="btnHbd" Property="Background" Value="{DynamicResource AccentColor}"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="BtnClose" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="32" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextSecondary}" Cursor="Hand" Click="BtnClose_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBd" Background="Transparent" CornerRadius="0,10,0,0">
                                                    <TextBlock Text="✕" FontSize="13" FontWeight="Normal"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBd" Property="Background" Value="#E81123"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="btnBd" Property="Background" Value="#C4101E"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 批注使用对象 - 顶置核心驱动控制栏 -->
            <Border Grid.Row="1" Background="{DynamicResource NavBg}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,0,0,1" Padding="8,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="使用对象:" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbTargetPersonaHero" Grid.Column="1" Height="22" FontSize="10" SelectionChanged="CmbTargetPersonaHero_SelectionChanged"/>
                    <Button x:Name="BtnApplyHeroTemplate" Grid.Column="2" Content="应用规则" Height="22" Style="{StaticResource SmallBtn}" Background="{DynamicResource AccentColor}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="6,0,0,0" FontSize="10" Click="BtnApplyHeroTemplate_Click"/>
                </Grid>
            </Border>

            <!-- 中间主内容区：左侧 5 大板块垂直导航 + 右侧紧凑容器 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧 5 大板块导航 -->
                <Border Grid.Column="0" Background="{DynamicResource NavBg}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,0,1,0">
                    <DockPanel LastChildFill="True">
                        <StackPanel Margin="0,4,0,0" DockPanel.Dock="Top">
                            <RadioButton x:Name="TabBtnAudience" Style="{StaticResource NavTabButton}" Content="对象与规则" IsChecked="True" Click="TabNav_Click"/>
                            <RadioButton x:Name="TabBtnDrawing" Style="{StaticResource NavTabButton}" Content="绘图与样式" Click="TabNav_Click"/>
                            <RadioButton x:Name="TabBtnRapid" Style="{StaticResource NavTabButton}" Content="极速与短语" Click="TabNav_Click"/>
                            <RadioButton x:Name="TabBtnKnowledge" Style="{StaticResource NavTabButton}" Content="规范知识库" Click="TabNav_Click"/>
                            <RadioButton x:Name="TabBtnSystem" Style="{StaticResource NavTabButton}" Content="快捷与系统" Click="TabNav_Click"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Bottom" Margin="4,0,4,4" VerticalAlignment="Bottom">
                            <TextBlock Text="InkVerse Studio" Foreground="{DynamicResource TextSecondary}" FontSize="9" Opacity="0.4" HorizontalAlignment="Center"/>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- 右侧各选项卡面板容器 -->
                <Border Grid.Column="1" Padding="8,6" Background="{DynamicResource WindowBg}">
                    <Grid>
                        <!-- ==================== 板块 0：批注使用对象与规则 ==================== -->
                        <ScrollViewer x:Name="PanelAudience" Style="{StaticResource SlimScrollViewer}" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                            <StackPanel>
                                <!-- 0.1 角色定位与参数详情卡片 -->
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <ComboBox x:Name="CmbProjectTemplates" Visibility="Collapsed" SelectionChanged="CmbProjectTemplates_SelectionChanged"/>

                                        <!-- 对象角色定位与职责说明卡片 -->
                                        <Border Background="{DynamicResource SubCardBg}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1" CornerRadius="4" Padding="6,5" Margin="0,0,0,5">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock x:Name="TxtTemplateRoleTitle" Text="角色身份" Foreground="#00E5FF" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock x:Name="TxtTemplatePlotLock" Text="强制不打印已锁定" Foreground="#FFA726" FontSize="9" HorizontalAlignment="Right" Visibility="Collapsed"/>
                                                </Grid>
                                                <TextBlock x:Name="TxtTemplateDesc" Text="详细说明" Foreground="{DynamicResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Foreground="{DynamicResource TextSecondary}" FontSize="9">
                                                        <Run Text="专属图层: "/><Run x:Name="TxtTemplateLayer" Text="CAD_NOTE_CLOUD" Foreground="#00E5FF" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" Foreground="{DynamicResource TextSecondary}" FontSize="9">
                                                        <Run Text="编号前缀: "/><Run x:Name="TxtTemplatePrefix" Text="#" Foreground="#00E5FF" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="4" Foreground="{DynamicResource TextSecondary}" FontSize="9">
                                                        <Run Text="打印: "/><Run x:Name="TxtTemplatePlot" Text="可打印" Foreground="#00E5FF" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 0.2 适用专业白名单与不相关专业置灰指示 -->
                                        <Border Background="{DynamicResource DeepCardBg}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,5">
                                            <StackPanel>
                                                <TextBlock Text="适用专业 (当前对象不相关专业自动置灰)" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="10" Margin="0,0,0,3"/>
                                                <WrapPanel x:Name="PanelAudienceDisciplines" Margin="0,2,0,2">
                                                    <Border x:Name="ChipAudienceArch" Background="{DynamicResource ChipBg}" BorderBrush="{DynamicResource ChipBorder}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,4,3">
                                                        <TextBlock Text="建筑" Foreground="{DynamicResource TextPrimary}" FontSize="9"/>
                                                    </Border>
                                                    <Border x:Name="ChipAudienceStruct" Background="{DynamicResource ChipBg}" BorderBrush="{DynamicResource ChipBorder}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,4,3">
                                                        <TextBlock Text="结构" Foreground="{DynamicResource TextPrimary}" FontSize="9"/>
                                                    </Border>
                                                    <Border x:Name="ChipAudiencePlumb" Background="{DynamicResource ChipBg}" BorderBrush="{DynamicResource ChipBorder}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,4,3">
                                                        <TextBlock Text="给排水" Foreground="{DynamicResource TextPrimary}" FontSize="9"/>
                                                    </Border>
                                                    <Border x:Name="ChipAudienceHvac" Background="{DynamicResource ChipBg}" BorderBrush="{DynamicResource ChipBorder}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,4,3">
                                                        <TextBlock Text="暖通" Foreground="{DynamicResource TextPrimary}" FontSize="9"/>
                                                    </Border>
                                                    <Border x:Name="ChipAudienceElect" Background="{DynamicResource ChipBg}" BorderBrush="{DynamicResource ChipBorder}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,4,3">
                                                        <TextBlock Text="电气" Foreground="{DynamicResource TextPrimary}" FontSize="9"/>
                                                    </Border>
                                                    <Border x:Name="ChipAudienceSite" Background="{DynamicResource ChipBg}" BorderBrush="{DynamicResource ChipBorder}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,4,3">
                                                        <TextBlock Text="总图" Foreground="{DynamicResource TextPrimary}" FontSize="9"/>
                                                    </Border>
                                                    <Border x:Name="ChipAudienceGeneral" Background="{DynamicResource ChipBg}" BorderBrush="{DynamicResource ChipBorder}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,4,3">
                                                        <TextBlock Text="通用" Foreground="{DynamicResource TextPrimary}" FontSize="9"/>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 0.3 专属审查意见高频短语库 (意见应用此模板规则) -->
                                        <Border Background="{DynamicResource DeepCardBg}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,5">
                                            <StackPanel>
                                                <TextBlock Text="专属审查意见库 (自动载入高频词条)" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="10" Margin="0,0,0,3"/>
                                                <ListBox x:Name="LstTemplateSnippets" Height="58" Background="{DynamicResource ListBg}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" FontSize="9"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 操作按钮行 -->
                                        <Button x:Name="BtnApplyTemplate" Visibility="Collapsed" Click="BtnApplyTemplate_Click"/>
                                        <Button x:Name="BtnExportTemplateExcel" Content="导出当前对象批注台账 Excel" Height="24" Style="{StaticResource SmallBtn}" Background="{DynamicResource ButtonBg}" Foreground="{DynamicResource TextPrimary}" FontSize="10" Click="BtnExportTemplateExcel_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- 0.4 专业分类与工作流 -->
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="3"/>
                                            <RowDefinition Height="22"/>
                                        </Grid.RowDefinitions>

                                        <!-- 所属专业 + 批注者 -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="默认专业:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="10"/>
                                                <ComboBox x:Name="CmbDiscipline" Grid.Column="1" Height="22" FontSize="10"/>
                                            </Grid>
                                            <Grid Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="默认批注者:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="10"/>
                                                <TextBox x:Name="TxtAssignee" Grid.Column="1" Height="22" FontSize="10"/>
                                            </Grid>
                                        </Grid>

                                        <!-- 默认优先级 -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="默认优先级:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="10"/>
                                            <ComboBox x:Name="CmbPriority" Grid.Column="1" Height="22" FontSize="10" SelectionChanged="CmbPriority_SelectionChanged"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- 0.5 存储分卷、审计防篡改与图纸健康 -->
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="存储分卷、审计防篡改与图纸健康" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" FontSize="10"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="单卷批注上限 (条):" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="10"/>
                                            <TextBox x:Name="TxtMaxNotesVolume" Grid.Column="1" Height="22" FontSize="10"/>
                                        </Grid>

                                        <CheckBox x:Name="ChkAuditTrail" Content="启用 SHA256 哈希链记录与防篡改审计日志" Margin="0,0,0,2" FontSize="10"/>
                                        <CheckBox x:Name="ChkAutoBackup" Content="保存 DWG 图纸时同步自动增量备份批注元数据" Margin="0,0,0,4" FontSize="10"/>

                                        <Border Background="{DynamicResource DeepCardBg}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="图纸健康体检与轻量化" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="10"/>
                                                    <TextBlock Text="清理孤儿 XRecord、幽灵扩展字典与失效句柄。" Foreground="{DynamicResource TextSecondary}" FontSize="9" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button x:Name="BtnCompactDatabase" Grid.Column="1" Content="一键体检" Height="22" Style="{StaticResource SmallBtn}" Background="{DynamicResource AccentColor}" Foreground="#FFFFFF" FontWeight="SemiBold" Click="BtnCompactDatabase_Click" FontSize="10"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ==================== 板块 1：绘图与样式 ==================== -->
                        <ScrollViewer x:Name="PanelDrawing" Style="{StaticResource SlimScrollViewer}" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="绘图几何、外观与样式联动" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,4"/>

                                <!-- 1.1 图层与基础外观 -->
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="3"/>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="3"/>
                                            <RowDefinition Height="22"/>
                                        </Grid.RowDefinitions>

                                        <!-- 云线图层 + 文字图层 -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="云线图层:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                                <TextBox x:Name="TxtCloudLayer" Grid.Column="1" Height="22" FontSize="11"/>
                                            </Grid>
                                            <Grid Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="文字图层:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                                <TextBox x:Name="TxtTextLayer" Grid.Column="1" Height="22" FontSize="11"/>
                                            </Grid>
                                        </Grid>

                                        <!-- 默认云线颜色 + 默认文字颜色 -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="默认云线色:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                                <ComboBox x:Name="CmbCloudColor" Grid.Column="1" Height="22" ItemTemplate="{StaticResource ColorSwatchTemplate}" SelectionChanged="CmbColors_SelectionChanged"/>
                                            </Grid>
                                            <Grid Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="文字颜色:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                                <ComboBox x:Name="CmbTextColor" Grid.Column="1" Height="22" ItemTemplate="{StaticResource ColorSwatchTemplate}" SelectionChanged="CmbColors_SelectionChanged"/>
                                            </Grid>
                                        </Grid>

                                        <!-- 文字样式 + 批注图层不打印 -->
                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="文字样式:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                                <ComboBox x:Name="CmbTextStyle" Grid.Column="1" Height="22" Style="{StaticResource BulletproofComboBox}"/>
                                            </Grid>
                                            <Grid Grid.Column="2">
                                                <CheckBox x:Name="ChkNonPlotting" Content="批注图层设置为不打印" VerticalAlignment="Center" FontSize="11"/>
                                                <TextBox x:Name="TxtTextHeightInLayer" Visibility="Collapsed"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- 1.2 云线几何与引线排版 -->
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="3"/>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="3"/>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="3"/>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="3"/>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="3"/>
                                            <RowDefinition Height="22"/>
                                        </Grid.RowDefinitions>

                                        <!-- 弧长比例系数 -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="75"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="58"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="弧长比例:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                            <Slider x:Name="SliderArcLength" Grid.Column="1" Minimum="3.0" Maximum="30.0" SmallChange="0.5" ValueChanged="SliderArcLength_ValueChanged" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtArcLengthVal" Grid.Column="2" Height="22" Margin="4,0,0,0" Padding="0" TextAlignment="Center" TextChanged="TxtArcLengthVal_TextChanged" FontSize="11" VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <!-- 圆弧凸度 -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="75"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="58"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="圆弧凸度:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                            <Slider x:Name="SliderBulge" Grid.Column="1" Minimum="0.2" Maximum="0.9" SmallChange="0.05" ValueChanged="SliderBulge_ValueChanged" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtBulgeVal" Grid.Column="2" Height="22" Margin="4,0,0,0" Padding="0" TextAlignment="Center" TextChanged="TxtBulgeVal_TextChanged" FontSize="11" VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <!-- 云线样式 + 云线线宽 -->
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="云线样式:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                                <ComboBox x:Name="CmbCloudStyle" Grid.Column="1" Height="22" Style="{StaticResource BulletproofComboBox}" SelectionChanged="CmbCloudStyle_SelectionChanged"/>
                                            </Grid>
                                            <Grid Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="云线线宽:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                                <ComboBox x:Name="CmbCloudWidth" Grid.Column="1" Height="22" Style="{StaticResource BulletproofComboBox}" SelectionChanged="CmbCloudWidth_SelectionChanged"/>
                                            </Grid>
                                        </Grid>

                                        <!-- 编号前缀 + 绘制模式 -->
                                        <Grid Grid.Row="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="编号前缀:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                                <TextBox x:Name="TxtPrefix" Grid.Column="1" Height="22" FontSize="11"/>
                                            </Grid>
                                            <Grid Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="绘制模式:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                                <ComboBox x:Name="CmbCloudType" Grid.Column="1" Height="22" Style="{StaticResource BulletproofComboBox}"/>
                                            </Grid>
                                        </Grid>

                                        <!-- 最小弧长 + 最大弧长 -->
                                        <Grid Grid.Row="7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="最小弧长:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                                <TextBox x:Name="TxtMinArc" Grid.Column="1" Height="22" FontSize="11"/>
                                            </Grid>
                                            <Grid Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="最大弧长:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                                <TextBox x:Name="TxtMaxArc" Grid.Column="1" Height="22" FontSize="11"/>
                                            </Grid>
                                        </Grid>

                                        <!-- 字高比例系数 -->
                                        <Grid Grid.Row="9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="75"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="58"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="字高比例:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                            <Slider x:Name="SliderTextHeight" Grid.Column="1" Minimum="1.5" Maximum="10.0" SmallChange="0.5" ValueChanged="SliderTextHeight_ValueChanged" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtTextHeightVal" Grid.Column="2" Height="22" Margin="4,0,0,0" Padding="0" TextAlignment="Center" TextChanged="TxtTextHeightVal_TextChanged" FontSize="11" VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <!-- 箭头大小系数 -->
                                        <Grid Grid.Row="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="75"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="58"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="箭头大小:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                            <Slider x:Name="SliderArrowSize" Grid.Column="1" Minimum="1.0" Maximum="8.0" SmallChange="0.5" ValueChanged="SliderArrowSize_ValueChanged" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtArrowSizeVal" Grid.Column="2" Height="22" Margin="4,0,0,0" Padding="0" TextAlignment="Center" TextChanged="TxtArrowSizeVal_TextChanged" FontSize="11" VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <!-- 引线模式 -->
                                        <Grid Grid.Row="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="75"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="引线模式:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                            <ComboBox x:Name="CmbLeaderType" Grid.Column="1" Height="22"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- 1.3 严重等级与颜色智能映射表 -->
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkPriorityColorLink" Content="启用优先级与云线颜色智能联动" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11" Margin="0,0,0,3"/>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 重要 -->
                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="重要:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                                <ComboBox x:Name="CmbColorImportant" Grid.Column="1" Height="22" ItemTemplate="{StaticResource ColorSwatchTemplate}" SelectionChanged="CmbColorPriority_SelectionChanged"/>
                                            </Grid>

                                            <!-- 紧急 -->
                                            <Grid Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="紧急:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                                <ComboBox x:Name="CmbColorUrgent" Grid.Column="1" Height="22" ItemTemplate="{StaticResource ColorSwatchTemplate}" SelectionChanged="CmbColorPriority_SelectionChanged"/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 1.4 实时几何与渲染预览卡片 -->
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="实时几何与渲染预览" Foreground="{DynamicResource TextSecondary}" FontSize="10" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Height="38" Background="{DynamicResource PreviewCardBg}" CornerRadius="4" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1">
                                            <Canvas x:Name="CanvasCloudPreview" ClipToBounds="True"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ==================== 板块 2：极速与短语 ==================== -->
                        <ScrollViewer x:Name="PanelRapid" Style="{StaticResource SlimScrollViewer}" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="急速批注策略与高频短语库" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,6"/>

                                <!-- 2.1 极速模式策略卡片 -->
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="急速批注策略" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="ChkPanelEnableSimpleMode" Content="启用急速批注模式 (免弹窗快速出图)" Margin="0,0,0,6" VerticalAlignment="Center" IsChecked="True" Checked="ChkSimpleMode_Changed" Unchecked="ChkSimpleMode_Changed"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="极速默认短语:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbRapidDefaultPhrase" Grid.Column="1" Height="26" IsEditable="True" ToolTip="直接选择或手动键入极速成图时默认使用的短语" SelectionChanged="CmbRapidDefaultPhrase_SelectionChanged"/>
                                        </Grid>

                                        <CheckBox x:Name="ChkEnableRapidCmdKey" Content="引线放置时支持快捷切词 (按 S 选短语 / 按 T 手动输入)" Margin="0,0,0,4" IsChecked="True"/>
                                        <TextBlock Text="说明：开启急速批注后，绘制云线并定位引线即可直接生成批注。" Foreground="{DynamicResource TextSecondary}" FontSize="10" TextWrapping="Wrap" LineHeight="14"/>
                                    </StackPanel>
                                </Border>

                                <!-- 2.2 高频快捷短语库管理卡片 -->
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="高频快捷短语词库管理" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}" FontSize="10" VerticalAlignment="Center">
                                                <Run Text="共 "/>
                                                <Run x:Name="TxtPhraseCount" Text="0" Foreground="{DynamicResource AccentColor}" FontWeight="Bold"/>
                                                <Run Text=" 条短语"/>
                                            </TextBlock>
                                        </Grid>

                                        <!-- 专业筛选与关键词检索 -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="专业分类:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbPhraseDisciplineFilter" Grid.Column="1" Height="24" SelectionChanged="CmbPhraseDisciplineFilter_SelectionChanged"/>
                                            <TextBlock Grid.Column="3" Text="检索:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtPhraseSearch" Grid.Column="4" Height="24" TextChanged="TxtPhraseSearch_TextChanged"/>
                                        </Grid>

                                        <!-- 短语列表 -->
                                        <ListBox x:Name="ListRapidPhrases" Height="110" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1" Margin="0,0,0,6" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{DynamicResource BadgeBg}" BorderBrush="{DynamicResource BadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding Discipline}" Foreground="#00E5FF" FontSize="10"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{DynamicResource TextPrimary}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                                                            <Button Content="设为默认" Style="{StaticResource SmallBtn}" Height="20" Padding="4,0" FontSize="10" Tag="{Binding}" Click="BtnSetAsDefaultPhrase_Click" ToolTip="将此短语设为极速批注默认短语"/>
                                                            <Button Content="删除" Style="{StaticResource SmallBtn}" Height="20" Padding="4,0" FontSize="10" Margin="4,0,0,0" Tag="{Binding}" Click="BtnDeletePhrase_Click" ToolTip="删除此短语"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- 词条新增输入行与操作按钮 -->
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="65"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="CmbNewPhraseDiscipline" Grid.Column="0" Height="24"/>
                                            <TextBox x:Name="TxtNewPhraseText" Grid.Column="2" Height="24" ToolTip="输入新快捷短语内容"/>
                                            <Button x:Name="BtnAddPhrase" Grid.Column="4" Content="添加" Style="{StaticResource SmallBtn}" Height="24" Click="BtnAddPhrase_Click"/>
                                            <Button x:Name="BtnResetPhrases" Grid.Column="6" Content="恢复预设" Style="{StaticResource SmallBtn}" Height="24" Click="BtnResetPhrases_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>


                        <!-- ==================== 板块 3：规范知识库 ==================== -->
                        <ScrollViewer x:Name="PanelKnowledge" Style="{StaticResource SlimScrollViewer}" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="国家现行规范条目与工程知识库" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,4"/>

                                <!-- 规范知识库设置 -->
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkEnableAi" Content="启用强条与工程规范条文速查联想" Margin="0,0,0,3" FontSize="11"/>

                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="75"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="58"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="匹配阈值:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                            <Slider x:Name="SliderAiThreshold" Grid.Column="1" Minimum="0.3" Maximum="0.95" SmallChange="0.05" ValueChanged="SliderAiThreshold_ValueChanged" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtAiThresholdVal" Grid.Column="2" Height="22" Margin="4,0,0,0" Padding="0" TextAlignment="Center" TextChanged="TxtAiThresholdVal_TextChanged" FontSize="11" VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <CheckBox x:Name="ChkAutoFillCode" Content="自动将规范条文编号 (如《通用规范》) 附加至批注内容" Margin="0,2,0,0" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- 规范条目管理 CRUD 区 -->
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtKbSearch" Grid.Column="0" Height="24" Margin="0,0,6,0" Padding="5,2" TextChanged="TxtKbSearch_TextChanged"/>
                                            <ComboBox x:Name="CmbKbFilterSource" Grid.Column="1" Height="24" Margin="0,0,6,0" SelectionChanged="CmbKbFilterSource_SelectionChanged"/>
                                            <ComboBox x:Name="CmbKbFilterDiscipline" Grid.Column="2" Height="24" SelectionChanged="CmbKbFilterDiscipline_SelectionChanged"/>
                                        </Grid>

                                        <!-- 规范列表展示 -->
                                        <ListBox x:Name="ListKnowledge" Height="140" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1" SelectionChanged="ListKnowledge_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46"/>
                                                            <ColumnDefinition Width="38"/>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- 来源标签：[国标] / [自定义] -->
                                                        <Border Grid.Column="0" Background="{Binding SourceBadgeBg}" BorderBrush="{Binding SourceBadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,4,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SourceBadge}" Foreground="{Binding SourceBadgeFg}" FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <!-- 专业标签 -->
                                                        <Border Grid.Column="1" Background="{DynamicResource BadgeBg}" CornerRadius="3" Padding="3,1" Margin="0,0,4,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Discipline}" Foreground="#64B5F6" FontSize="10"/>
                                                        </Border>
                                                        <!-- 条目标题 -->
                                                        <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                                        <!-- 依据规范代号（无依据或自定义则显示灰色横杠） -->
                                                        <TextBlock Grid.Column="3" Text="{Binding DisplayStandardCode}" Foreground="{DynamicResource TextSecondary}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- 操作按钮条 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                                            <Button x:Name="BtnAddKb" Content="新增条目" Style="{StaticResource SmallBtn}" Width="65" Height="24" Margin="0,0,5,0" Click="BtnAddKb_Click"/>
                                            <Button x:Name="BtnEditKb" Content="编辑条目" Style="{StaticResource SmallBtn}" Width="65" Height="24" Margin="0,0,5,0" Click="BtnEditKb_Click"/>
                                            <Button x:Name="BtnDeleteKb" Content="删除条目" Style="{StaticResource SmallBtn}" Width="65" Height="24" Margin="0,0,5,0" Click="BtnDeleteKb_Click"/>
                                            <Button x:Name="BtnResetKb" Content="恢复内置现行标准" Style="{StaticResource SmallBtn}" Width="115" Height="24" Click="BtnResetKb_Click"/>
                                        </StackPanel>

                                        <!-- 内联编辑/新增区域 -->
                                        <Border x:Name="BorderKbEditor" Background="{DynamicResource InputBg}" CornerRadius="4" Padding="8" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1" Visibility="Collapsed">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="26"/>
                                                    <RowDefinition Height="26"/>
                                                    <RowDefinition Height="42"/>
                                                    <RowDefinition Height="26"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="所属专业:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="CmbKbItemDiscipline" Grid.Row="0" Grid.Column="1" Height="22" Margin="0,0,6,0"/>

                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="依据规范:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtKbItemStdCode" Grid.Row="0" Grid.Column="3" Height="22"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="条目标题:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtKbItemTitle" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="22"/>
                                                <TextBox x:Name="TxtKbItemCode" Visibility="Collapsed"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="审查意见:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                <TextBox x:Name="TxtKbItemSuggestion" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Height="36" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                                                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                    <Button x:Name="BtnCancelKbItem" Content="取消" Style="{StaticResource SmallBtn}" Width="55" Height="22" Margin="0,0,6,0" Click="BtnCancelKbItem_Click"/>
                                                    <Button x:Name="BtnSaveKbItem" Content="保存条目" Style="{StaticResource SmallBtn}" Background="{DynamicResource AccentColor}" Foreground="White" Width="68" Height="22" Click="BtnSaveKbItem_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ==================== 板块 4：快捷与系统 ==================== -->
                        <ScrollViewer x:Name="PanelSystem" Style="{StaticResource SlimScrollViewer}" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="快捷指令速查与系统交互偏好" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,6"/>

                                <!-- 核心 3 大主指令 -->
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="核心快捷指令与一键调用" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,6"/>

                                        <!-- 1. CN / CNOTE -->
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="96"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CmdTagStyle}" Margin="0" HorizontalAlignment="Stretch" Height="22">
                                                    <TextBlock Text="CN" Foreground="#00E5FF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="2" Style="{StaticResource CmdTagStyle}" Margin="0" HorizontalAlignment="Stretch" Height="22">
                                                    <TextBlock Text="CNOTE" Foreground="#00E5FF" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="新建批注：框选范围生成云线、引线与标注" TextWrapping="Wrap" Margin="8,0,8,0" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                            <Button Grid.Column="2" Content="执行" Style="{StaticResource SmallBtn}" Height="22" Padding="0" Tag="CNOTE" Click="BtnExecCmd_Click" FontSize="11" Cursor="Hand"/>
                                        </Grid>

                                        <!-- 2. CNP / CNOTEPANEL -->
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="96"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CmdTagStyle}" Margin="0" HorizontalAlignment="Stretch" Height="22">
                                                    <TextBlock Text="CNP" Foreground="#00E5FF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="2" Style="{StaticResource CmdTagStyle}" Margin="0" HorizontalAlignment="Stretch" Height="22">
                                                    <TextBlock Text="CNOTEPANEL" Foreground="#00E5FF" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="管理看板：呼出右侧看板，管理流转与导出" TextWrapping="Wrap" Margin="8,0,8,0" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                            <Button Grid.Column="2" Content="执行" Style="{StaticResource SmallBtn}" Height="22" Padding="0" Tag="CNP" Click="BtnExecCmd_Click" FontSize="11" Cursor="Hand"/>
                                        </Grid>

                                        <!-- 3. CNS / CNOTESET -->
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="96"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CmdTagStyle}" Margin="0" HorizontalAlignment="Stretch" Height="22">
                                                    <TextBlock Text="CNS" Foreground="#00E5FF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="2" Style="{StaticResource CmdTagStyle}" Margin="0" HorizontalAlignment="Stretch" Height="22">
                                                    <TextBlock Text="CNOTESET" Foreground="#00E5FF" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="参数设置：打开当前全局配置视窗" TextWrapping="Wrap" Margin="8,0,8,0" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                            <Button Grid.Column="2" Content="执行" Style="{StaticResource SmallBtn}" Height="22" Padding="0" Tag="CNS" Click="BtnExecCmd_Click" FontSize="11" Cursor="Hand"/>
                                        </Grid>

                                        <!-- 4. CNQ / NOTEQUICK -->
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="96"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CmdTagStyle}" Margin="0" HorizontalAlignment="Stretch" Height="22">
                                                    <TextBlock Text="CNQ" Foreground="#00E5FF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="2" Style="{StaticResource CmdTagStyle}" Margin="0" HorizontalAlignment="Stretch" Height="22">
                                                    <TextBlock Text="NOTEQUICK" Foreground="#00E5FF" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="极速批注：免弹窗命令行快速框选与批注" TextWrapping="Wrap" Margin="8,0,8,0" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                            <Button Grid.Column="2" Content="执行" Style="{StaticResource SmallBtn}" Height="22" Padding="0" Tag="CNQ" Click="BtnExecCmd_Click" FontSize="11" Cursor="Hand"/>
                                        </Grid>

                                        <!-- 5. CNAC / CNADDCLOUD -->
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="96"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CmdTagStyle}" Margin="0" HorizontalAlignment="Stretch" Height="22">
                                                    <TextBlock Text="CNAC" Foreground="#00E5FF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="2" Style="{StaticResource CmdTagStyle}" Margin="0" HorizontalAlignment="Stretch" Height="22">
                                                    <TextBlock Text="CNADDCLOUD" Foreground="#00E5FF" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="追加云线：向已有批注追加新云线框与分枝引线" TextWrapping="Wrap" Margin="8,0,8,0" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                            <Button Grid.Column="2" Content="执行" Style="{StaticResource SmallBtn}" Height="22" Padding="0" Tag="CNADDCLOUD" Click="BtnExecCmd_Click" FontSize="11" Cursor="Hand"/>
                                        </Grid>

                                         <!-- 6. CNCV / CNCONVERT -->
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="96"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CmdTagStyle}" Margin="0" HorizontalAlignment="Stretch" Height="22">
                                                    <TextBlock Text="CNCV" Foreground="#00E5FF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="2" Style="{StaticResource CmdTagStyle}" Margin="0" HorizontalAlignment="Stretch" Height="22">
                                                    <TextBlock Text="CNCONVERT" Foreground="#00E5FF" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="对象转云线：选择多段线/圆/椭圆等转换为云线批注" TextWrapping="Wrap" Margin="8,0,8,0" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                            <Button Grid.Column="2" Content="执行" Style="{StaticResource SmallBtn}" Height="22" Padding="0" Tag="CNCONVERT" Click="BtnExecCmd_Click" FontSize="11" Cursor="Hand"/>
                                        </Grid>

                                        <!-- 7. CNH / CNHELP -->
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="96"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CmdTagStyle}" Margin="0" HorizontalAlignment="Stretch" Height="22">
                                                    <TextBlock Text="CNH" Foreground="#00E5FF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="2" Style="{StaticResource CmdTagStyle}" Margin="0" HorizontalAlignment="Stretch" Height="22">
                                                    <TextBlock Text="CNHELP" Foreground="#00E5FF" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="帮助手册：打开本地 Readme.html 完整离线手册" TextWrapping="Wrap" Margin="8,0,8,0" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                            <Button Grid.Column="2" Content="打开" Style="{StaticResource SmallBtn}" Height="22" Padding="0" Tag="CNHELP" Click="BtnExecCmd_Click" FontSize="11" Cursor="Hand"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 系统交互偏好 -->
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="系统交互与视口反馈偏好" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="ChkAutoZoom" Content="双击看板列表项时自动缩放居中定位至云线视口" Margin="0,3,0,3"/>
                                        <CheckBox x:Name="ChkSound" Content="批注流转状态变动或完成时播放系统提示音" Margin="0,3,0,3"/>
                                    </StackPanel>
                                </Border>

                                <!-- 架构说明卡片 -->
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="集中化看板协同说明" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3" FontSize="11"/>
                                        <TextBlock Text="本插件全面采用看板集中协同架构。图纸中的批注流转生命周期、图面表格生成、Excel 导出以及规范知识库均已高度收敛至【管理看板 (CNP)】中，在面板中直接操作即可，无需在命令行记忆繁杂选项。" 
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" LineHeight="16" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 底部操作与开发者版权栏 -->
            <Border Grid.Row="3" Background="{DynamicResource TitleBarBg}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,1,0,0" Padding="8,4,8,4" CornerRadius="0,0,10,10">
                <StackPanel>
                    <!-- 上层控制按钮栏 -->
                    <Grid Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button x:Name="BtnReset" Width="68" Height="22" Content="恢复默认" Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1" Padding="0" HorizontalContentAlignment="Center" Cursor="Hand" Click="BtnReset_Click" FontSize="10"/>
                            <CheckBox x:Name="ChkEnableSimpleNoteMode" Content="急速批注" Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="True" Checked="ChkSimpleMode_Changed" Unchecked="ChkSimpleMode_Changed" FontSize="10"/>
                            <ComboBox x:Name="CmbBottomRapidPhrase" Width="92" Height="22" Margin="4,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkEnableSimpleNoteMode}" ToolTip="急速批注默认成图短语" SelectionChanged="CmbBottomRapidPhrase_SelectionChanged" FontSize="10"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnHelpBottom" Width="46" Height="22" Content="帮助" Background="{DynamicResource ButtonBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand" Click="BtnHelp_Click" FontSize="10" ToolTip="打开本地使用手册 (Readme.html)"/>
                            <Button x:Name="BtnCancel" Width="46" Height="22" Content="取消" Background="{DynamicResource ButtonBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand" Click="BtnCancel_Click" FontSize="10"/>
                            <Button x:Name="BtnSave" Width="76" Height="22" Content="保存并应用" Background="{DynamicResource AccentColor}" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click" FontSize="10"/>
                        </StackPanel>
                    </Grid>

                    <!-- 下层开发者与开源地址栏 -->
                    <Grid Margin="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock FontSize="9" Opacity="0.85">
                                <Hyperlink Click="LnkHelp_Click" Foreground="{DynamicResource AccentColor}" TextDecorations="None">📖 使用帮助(Readme)</Hyperlink>
                                <Run Text="  |  " Foreground="{DynamicResource BorderLine}"/>
                                <Hyperlink NavigateUri="https://github.com/Andyang127/CadAutoCloudNote" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource AccentColor}" TextDecorations="None">开源地址</Hyperlink>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock HorizontalAlignment="Right" FontSize="9" Opacity="0.7">
                            <Run Text="Developed by " Foreground="{DynamicResource TextSecondary}"/>
                            <Hyperlink NavigateUri="https://v.douyin.com/EQGXP6k0l2g/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource AccentColor}" TextDecorations="None">浅醉·墨语</Hyperlink>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
