<Window x:Class="CadAutoCloudNote.Core.UI.Wpf.NoteEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CAD Auto CloudNote - 新建/编辑批注"
        Width="410" SizeToContent="Height" MinHeight="420" MaxHeight="550"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Microsoft YaHei" FontSize="12">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#323B47"/>
        <SolidColorBrush x:Key="CardBg" Color="#282F3B"/>
        <SolidColorBrush x:Key="TitleBarBg" Color="#222933"/>
        <SolidColorBrush x:Key="AccentColor" Color="#0084FF"/>
        <SolidColorBrush x:Key="AccentHover" Color="#2997FF"/>
        <SolidColorBrush x:Key="AccentGlow" Color="#1E3A5F"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A2B0C4"/>
        <SolidColorBrush x:Key="BorderLine" Color="#434E60"/>
        <SolidColorBrush x:Key="InputBg" Color="#1D232C"/>
        <SolidColorBrush x:Key="ButtonBg" Color="#384352"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#475568"/>
        <SolidColorBrush x:Key="ThumbNormalBg" Color="#5A6578"/>
        <SolidColorBrush x:Key="ThumbHoverBg" Color="#8A99B0"/>
        <SolidColorBrush x:Key="SubCardBg" Color="#1F2833"/>
        <SolidColorBrush x:Key="PreviewCardBg" Color="#1C222B"/>
        <SolidColorBrush x:Key="ChipBg" Color="#252D37"/>
        <SolidColorBrush x:Key="ChipBorder" Color="#333D4B"/>
        <SolidColorBrush x:Key="ChipDisabledBg" Color="#1E232B"/>
        <SolidColorBrush x:Key="BadgeBg" Color="#1B3552"/>
        <SolidColorBrush x:Key="BadgeBorder" Color="#2D5580"/>

        <!-- 扁平现代输入框样式 (透彻圆角 CornerRadius="5", 支持多行居顶与单行居中) -->
        <Style TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="AcceptsReturn" Value="True">
                                <Setter Property="VerticalContentAlignment" Value="Top"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextSecondary}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代统一圆角按钮样式 (透彻圆角 CornerRadius="5") -->
        <Style TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 极简流线滑块与滚动条样式 -->
        <Style x:Key="SlimScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumbBorder" Background="{DynamicResource ThumbNormalBg}" CornerRadius="2.5"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ThumbHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimVerticalScrollBar" TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollViewer" TargetType="ScrollViewer">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                                       Style="{StaticResource SlimVerticalScrollBar}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer" BasedOn="{StaticResource SlimScrollViewer}"/>

        <!-- 防刺眼 Fluent 暗黑 ComboBoxItem 样式 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 防刺眼 BulletproofComboBox 样式 (彻底解决白底白字与刺眼问题，完美支持可编辑输入与下拉) -->
        <Style x:Key="BulletproofComboBox" TargetType="ComboBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder" 
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 覆盖在区域上响应点击弹出 (非可编辑模式下覆盖全框，可编辑模式下收敛至右侧按钮列) -->
                                    <ToggleButton x:Name="DropDownToggle"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <!-- 非编辑模式下的显示内容 -->
                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>

                                    <!-- 可编辑模式下的文本输入展示框 (必须命名为 PART_EditableTextBox) -->
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Style="{x:Null}"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextPrimary}"
                                             BorderThickness="0"
                                             Padding="{TemplateBinding Padding}"
                                             VerticalContentAlignment="Center"
                                             CaretBrush="{DynamicResource AccentColor}"
                                             SelectionBrush="{DynamicResource AccentColor}"
                                             Visibility="Collapsed"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"/>

                                    <!-- 箭头图标 -->
                                    <Path x:Name="Arrow"
                                          Grid.Column="1"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{DynamicResource TextSecondary}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <!-- 下拉浮层 (深色背景，无白屏) -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   Focusable="False">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource WindowBg}"
                                        BorderBrush="{DynamicResource BorderLine}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,2,0,4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4" Color="Black"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="DropDownToggle" Property="Grid.Column" Value="1"/>
                                <Setter TargetName="DropDownToggle" Property="Grid.ColumnSpan" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" CenterX="4" CenterY="2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource BulletproofComboBox}"/>

        <!-- 复选框样式 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 专业胶囊 Chip 样式 (圆润药丸 CornerRadius="10") -->
        <Style x:Key="DisciplineChipStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Background" Value="{DynamicResource ChipBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="Margin" Value="0,0,3,3"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="chipBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="chipBorder" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="chipBorder" Property="Background" Value="{DynamicResource ChipDisabledBg}"/>
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="{DynamicResource ChipBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 扁平现代卡片样式 (透彻圆角 CornerRadius="8") -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <!-- 主容器卡片 (全局圆角 CornerRadius="10") -->
    <Border Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 (CornerRadius="10,10,0,0") -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBg}" CornerRadius="10,10,0,0" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="新建/编辑云线批注" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BadgeBg}" BorderBrush="{DynamicResource BadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTemplateBadge" Text="通用审图" Foreground="{DynamicResource AccentColor}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="36" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextSecondary}" Cursor="Hand" Click="BtnCancel_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBd" Background="Transparent" CornerRadius="0,10,0,0">
                                                <TextBlock Text="✕" FontSize="14" FontWeight="Normal"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBd" Property="Background" Value="#E81123"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="btnBd" Property="Background" Value="#C4101E"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 中间主内容区 (自适应卡片容器，开启极简流线自动滚动条防截断) -->
            <ScrollViewer Grid.Row="1" Style="{StaticResource SlimScrollViewer}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="10,6">
                <StackPanel>
                    <!-- 1. 批注信息录入卡片 (专业置顶 -> 标题下拉+手动输入 -> 问题等级与批注者) -->
                    <Border Style="{StaticResource CardStyle}" Padding="10,7" Margin="0,0,0,5">
                        <StackPanel>
                            <!-- 1.0 批注使用对象 (使用本工具的人) - 顶层驱动规则引擎 -->
                            <Border Background="{DynamicResource SubCardBg}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1" CornerRadius="5" Padding="6,4" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock Text="批注使用对象:" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbTargetPersona" Grid.Column="1" Height="24" FontSize="11" DisplayMemberPath="Name" SelectionChanged="CmbTargetPersona_SelectionChanged"/>
                                </Grid>
                            </Border>

                            <!-- 1.1 所属专业置顶 (胶囊 Chips) -->
                            <TextBlock Text="所属专业" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                            <WrapPanel x:Name="PanelDisciplineChips" Margin="0,0,0,6">
                                <RadioButton Content="建筑" Style="{StaticResource DisciplineChipStyle}" IsChecked="True" Checked="DisciplineChip_Checked"/>
                                <RadioButton Content="结构" Style="{StaticResource DisciplineChipStyle}" Checked="DisciplineChip_Checked"/>
                                <RadioButton Content="给排水" Style="{StaticResource DisciplineChipStyle}" Checked="DisciplineChip_Checked"/>
                                <RadioButton Content="暖通" Style="{StaticResource DisciplineChipStyle}" Checked="DisciplineChip_Checked"/>
                                <RadioButton Content="电气" Style="{StaticResource DisciplineChipStyle}" Checked="DisciplineChip_Checked"/>
                                <RadioButton Content="总图" Style="{StaticResource DisciplineChipStyle}" Checked="DisciplineChip_Checked"/>
                                <RadioButton Content="通用" Style="{StaticResource DisciplineChipStyle}" Checked="DisciplineChip_Checked"/>
                            </WrapPanel>

                            <!-- 1.2 批注标号前缀与序号 -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="标号前缀" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CmbPrefix" Height="26" IsEditable="True" Style="{StaticResource BulletproofComboBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="序号 (递加)" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtSequence" Height="26" TextChanged="Inputs_Changed"/>
                                </StackPanel>
                            </Grid>

                            <!-- 1.3 批注标题 -->
                            <TextBlock Text="批注标题" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbTitle" Height="26" IsEditable="True" Style="{StaticResource BulletproofComboBox}" Margin="0,0,0,6"/>

                            <!-- 1.3 问题等级与批注者 -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="问题等级" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CmbPriority" Height="26" Style="{StaticResource BulletproofComboBox}" SelectionChanged="CmbPriority_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="批注者" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtAssignee" Height="26" TextChanged="Inputs_Changed"/>
                                </StackPanel>
                            </Grid>

                            <!-- 1.4 依据规范条文速选 -->
                            <TextBlock Text="依据规范条文速查" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbKnowledge" Height="26" Style="{StaticResource BulletproofComboBox}" Margin="0,0,0,6" SelectionChanged="CmbKnowledge_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- 1.5 审查意见详情 / 依据规范说明 -->
                            <TextBlock Text="审查意见详情 / 规范条文" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtContent" Height="75" FontSize="11" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" Padding="6,6" TextChanged="Inputs_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. 实时图面批注呈现预览卡片 -->
                    <Border Style="{StaticResource CardStyle}" Padding="10,6" Margin="0,0,0,2">
                        <StackPanel>
                            <TextBlock Text="图面效果预览" Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource PreviewCardBg}" CornerRadius="5" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1" Padding="8,5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 卡片标题栏 -->
                                    <Grid Grid.Row="0" Margin="0,0,0,3">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="BadgeDiscipline" Background="{DynamicResource BadgeBg}" BorderBrush="{DynamicResource BadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                                                <TextBlock x:Name="TxtPreviewDiscipline" Text="建筑" Foreground="#38BDF8" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border x:Name="BadgePriority" Background="#D97706" CornerRadius="3" Padding="5,1">
                                                <TextBlock x:Name="TxtPreviewPriority" Text="重要" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock x:Name="TxtPreviewTitle" Text="批注标题示例" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                                        </StackPanel>

                                        <TextBlock x:Name="TxtPreviewAssignee" Text="批注者: admin" Foreground="{DynamicResource TextSecondary}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- 卡片详情文本 -->
                                    <TextBlock x:Name="TxtPreviewContent" Grid.Row="1" Text="审查意见内容与规范条文..." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" LineHeight="14" FontSize="10" MinHeight="14" MaxHeight="38" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部操作栏 (CornerRadius="0,0,10,10") -->
            <Border Grid.Row="2" Background="{DynamicResource TitleBarBg}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,1,0,0" Padding="12,8" CornerRadius="0,0,10,10">
                <Grid>
                    <CheckBox x:Name="ChkSaveToLibrary" Content="存入常用快捷短语库" IsChecked="True"
                              VerticalAlignment="Center" HorizontalAlignment="Left"
                              Foreground="{DynamicResource TextSecondary}" FontSize="11" Cursor="Hand"
                              ToolTip="勾选后，点击【确定生成批注】将自动把本条批注标题保存至高频快捷短语库，下次可直接下拉速选"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancel" Content="取消" Width="68" Height="28" Background="{DynamicResource ButtonBg}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0" Cursor="Hand" Click="BtnCancel_Click" FontSize="11"/>
                        <Button x:Name="BtnOk" Content="确定生成批注" Width="110" Height="28" Background="{DynamicResource AccentColor}" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnOk_Click" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
