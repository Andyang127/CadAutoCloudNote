<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>CadAutoCloudNote.Tests</RootNamespace>
    <AssemblyName>CadAutoCloudNote.Tests</AssemblyName>
    
    <OutputPath>..\build\Tests\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    
    <DefineConstants>$(DefineConstants);CAD_R24;USE_WPF;IN_UNIT_TEST</DefineConstants>
    <Platforms>AnyCPU;x64</Platforms>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <Import Project="..\CadAutoCloudNote.Core\CadAutoCloudNote.Core.projitems" Label="Shared" />

  <ItemGroup>
    <Reference Include="AcCoreMgd">
      <HintPath>..\Libs\AutoCAD\Net4.8_2021-2024\accoremgd.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>..\Libs\AutoCAD\Net4.8_2021-2024\acdbmgd.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>..\Libs\AutoCAD\Net4.8_2021-2024\acmgd.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>..\Libs\AutoCAD\Net4.8_2021-2024\AdWindows.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
</Project>
